{
  "name": "is-modasi",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-static.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "wrangler dev --local --ip 127.0.0.1",
    "deploy": "wrangler deploy --no-autoconfig",
    "preview": "wrangler preview",
    "check:catalog": "node scripts/check-catalog.mjs",
    "import:catalog": "node scripts/import-catalog.mjs",
    "prebuild": "node scripts/prepare-static.mjs",
    "postbuild": "npm run check:static",
    "check:static": "node scripts/check-static.mjs",
    "test:contact": "wrangler deploy --no-autoconfig --dry-run --outdir output/contact-worker && node scripts/check-contact.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "gsap": "^3.15.0",
    "next": "^16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.155.0"
  }
}
